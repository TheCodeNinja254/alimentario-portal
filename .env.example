###
## Copy this file to .env in your local environment and set appropriate values
## Do NOT check in the .env file but you can check this example in if you
## add custom variables so team can know about them
###

## Environment variables.
SKIP_PREFLIGHT_CHECK=true
#AuthToken
REACT_APP_AX=

# Graphql endpoint - localhost
REACT_APP_APOLLO_CLIENT__HTTP_LINK__URI=
#
#REACT_APP_WEBSOCKET_URL=

REACT_APP_APOLLO_ENVIRONMENT=

#Encryption Key
REACT_APP_EK=
#Initialization Vector
REACT_APP_IV=
# React port
PORT=3000
REACT_APP_BASENAME=

# 90fY2cgtRu5t

#Environment Variables
REACT_APP_IGNORE_SSL=false
REACT_APP_TIMEOUT=900
GENERATE_SOURCEMAP=false

DISABLE_ESLINT_PLUGIN=true

REACT_APP_HORSE_RACE_SCHEDULE=
